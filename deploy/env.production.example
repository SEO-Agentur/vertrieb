# Kopieren nach /opt/kivertrieb/.env, ausfuellen, chmod 600. Niemals committen.
# Werte ohne Anfuehrungszeichen und ohne Kommentar in derselben Zeile eintragen.
# POSTGRES_PASSWORD: openssl rand -hex 24  |  SESSION_SECRET: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_URL=https://app.kivertrieb.net
SESSION_SECRET=
# Erster Admin (Passwort min. 10 Zeichen)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Optional - ohne Werte sind die Funktionen als "nicht aktiviert" gekennzeichnet
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Port 25 ist bei Hostinger gesperrt - SMTP eines Transaktionsdienstes nutzen (z.B. Resend/Postmark, Port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
