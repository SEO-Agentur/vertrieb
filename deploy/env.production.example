# Kopieren nach .env.production (im Projektordner) und ausfüllen. Diese Datei niemals committen.
POSTGRES_PASSWORD=            # langes Zufallspasswort: openssl rand -hex 24
APP_URL=https://app.kivertrieb.net
SESSION_SECRET=               # openssl rand -hex 32
NODE_ENV=production

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=          # min. 10 Zeichen
SEED_ADMIN_NAME=

# Optional – ohne Werte sind die Funktionen als "nicht aktiviert" gekennzeichnet
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
