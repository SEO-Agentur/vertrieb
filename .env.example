# ── Pflicht ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salesplatform"
APP_URL="http://localhost:3000"               # öffentliche Basis-URL (für Einladungslinks)
SESSION_SECRET="bitte-durch-langen-zufallswert-ersetzen"   # min. 32 Zeichen, z.B. `openssl rand -hex 32`

# ── Seed (erster Admin) ─────────────────────────────────
SEED_ADMIN_EMAIL="berater@example.com"
SEED_ADMIN_PASSWORD="bitte-aendern"
SEED_ADMIN_NAME="Alex Berater"

# ── KI (optional – ohne Key ist die KI als „nicht aktiviert" gekennzeichnet) ──
AI_PROVIDER="anthropic"
AI_MODEL="claude-opus-5-5"
ANTHROPIC_API_KEY=""

# ── Videoberatung über LiveKit (optional) ───────────────
# Lokal: docker compose --profile video up livekit  → LIVEKIT_URL=ws://localhost:7880, Key/Secret: devkey / secret
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ── E-Mail-Versand (optional – sonst Postausgang mit Status NOT_CONFIGURED) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Berater <berater@example.com>"

# ── SEO-Scanner guaranteedseoservices.com (optional, API-Verfügbarkeit ungeklärt) ──
SEO_SCANNER_API_URL=""
SEO_SCANNER_API_KEY=""
